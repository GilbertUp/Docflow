# Copy to .env and replace every value. .env is ignored by Git.
# Passwords and S3 keys: use long random values.
# Encryption keys: 32 random bytes in base64, each different, for example:
#   python -c "import base64,os; print(base64.b64encode(os.urandom(32)).decode())"
# Losing DOCUFLOW_MASTER_KEY makes every stored document unreadable. Back it up separately.

DOCUFLOW_ENVIRONMENT=development

# Malware scanning. "none" is for development only; production refuses to start with it.
# To scan, set clamav and start the stack with --profile scan.
DOCUFLOW_SCANNER=none

POSTGRES_PASSWORD=
DOCUFLOW_MIGRATOR_PASSWORD=
DOCUFLOW_APP_PASSWORD=
DOCUFLOW_PLATFORM_PASSWORD=

DOCUFLOW_S3_ACCESS_KEY=
DOCUFLOW_S3_SECRET_KEY=

DOCUFLOW_MASTER_KEY=
DOCUFLOW_AUDIT_HMAC_KEY=
